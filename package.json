{
  "name": "lumora-agent-governance",
  "version": "0.4.0",
  "description": "Codex governance, prompt capture and testing skills for any local project connected through Lumora",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=24.0.0"
  },
  "bin": {
    "lumora-agent": "dist/npm/bin/lumora-agent.mjs"
  },
  "scripts": {
    "start": "node src/cli.ts serve",
    "test": "node --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "test:ui": "node --test tests/browser.spec.ts",
    "verify": "npm run typecheck && npm test",
    "pack:plugin": "node src/cli.ts package --out dist/lumora-governance-0.4.0",
    "build": "node src/cli.ts build",
    "prepack": "npm run build",
    "demo": "node src/cli.ts demo"
  },
  "dependencies": {
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@types/node": "24.10.1",
    "typescript": "5.9.3"
  },
  "files": [
    "dist/npm",
    "README.md",
    "docs/IMPLEMENTATION_PLAN.md",
    "docs/INTEGRATION.md",
    "docs/VALIDATION.md",
    "docs/screenshots",
    "docs/INSTALL_ONCE.md",
    "docs/LOCAL_PROJECT_WORKFLOW.md",
    "docs/PROJECT_RULES.md"
  ]
}
